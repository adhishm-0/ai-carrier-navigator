# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_CHATGPT_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_CHATGPT_MODEL=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-02-01

# Flask Configuration
DEBUG=False
HOST=0.0.0.0
PORT=8000

# CORS Configuration (use * for development, specify domains for production)
CORS_ORIGINS=*

# Local Postgres (development)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_career_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Optionally provide a full DATABASE_URL instead of the individual POSTGRES_* vars
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_career_db
